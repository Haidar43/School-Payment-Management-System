# Use SQLite (no server needed)
DATABASE_URL=sqlite:///./school_payment.db

# For PostgreSQL (comment this out if not using)
# DATABASE_URL=postgresql://user:password@localhost:5432/school_payment

# For MySQL (comment this out if not using)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/school_payment

# Secret key for JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440