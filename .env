# Use SQLite (no server needed)
DATABASE_URL=sqlite:///./school_payment.db


# Secret key for JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_4df0026b3f97d83363b2b59a0086b774b4469431"
PAYSTACK_PUBLIC_KEY="pk_test_a5c0300c0899b32997dd4a488eca336d60048013"
APP_ENV=development  # development, test, production

# URL for webhook (for Paystack to call)
WEBHOOK_URL=https://your-domain.com/webhook/paystack


# Payment
MIN_PAYMENT_AMOUNT=1000  # Minimum ₦1,000
ALLOW_PARTIAL_PAYMENT=true

# Callback URLs
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/verify
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_FAILURE_URL=http://localhost:3000/payment/failure